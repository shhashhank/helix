{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2022",
    "module": "commonjs",
    "lib": ["es2022", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@helix/llm": ["libs/llm/src/index.ts"],
      "@helix/agent": ["libs/agent/src/index.ts"],
      "@helix/workflow": ["libs/workflow/src/index.ts"],
      "@helix/workflow/temporal-client": ["libs/workflow/src/temporal-client.ts"],
      "@helix/mcp": ["libs/mcp/src/index.ts"],
      "@helix/github-mcp": ["libs/github-mcp/src/index.ts"],
      "@helix/github-mcp/app-auth": ["libs/github-mcp/src/app-auth.ts"],
      "@helix/github-mcp/worker-client": ["libs/github-mcp/src/worker-client.ts"],
      "@helix/secrets": ["libs/secrets/src/index.ts"],
      "@helix/secrets/aws-kms": ["libs/secrets/src/aws-kms.ts"],
      "@helix/secrets/aws-secrets-store": ["libs/secrets/src/aws-secrets-store.ts"],
      "@helix/planning": ["libs/planning/src/index.ts"],
      "@helix/sandbox": ["libs/sandbox/src/index.ts"],
      "@helix/coding-agent": ["libs/coding-agent/src/index.ts"],
      "@helix/review-agent": ["libs/review-agent/src/index.ts"],
      "@helix/testing-agent": ["libs/testing-agent/src/index.ts"],
      "@helix/deployment-agent": ["libs/deployment-agent/src/index.ts"],
      "@helix/approvals": ["libs/approvals/src/index.ts"],
      "@helix/notifications": ["libs/notifications/src/index.ts"],
      "@helix/audit": ["libs/audit/src/index.ts"],
      "@helix/telemetry": ["libs/telemetry/src/index.ts"],
      "@helix/analytics": ["libs/analytics/src/index.ts"],
      "@helix/auth": ["libs/auth/src/index.ts"],
      "@helix/tenancy": ["libs/tenancy/src/index.ts"],
      "@helix/executor": ["libs/executor/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
