generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("REGISTRY_DATABASE_URL")
  extensions = [vector]
}

model AgentDefinition {
  id           String   @id @default(uuid()) @db.Uuid
  orgId        String?  @map("org_id") @db.Uuid
  role         String   @db.Text
  version      Int
  name         String   @db.Text
  description  String?  @db.Text
  systemPrompt Json     @map("system_prompt")
  modelPolicy  Json     @map("model_policy")
  tools        Json
  guardrails   Json
  outputSchema Json?    @map("output_schema")
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@unique([orgId, role, version])
  @@index([orgId, role, deletedAt])
  @@map("agent_definitions")
}

/// A versioned approval policy (HELIX-128/129): gate rules + approver roles + SLAs,
/// stored as a validated document (the `@helix/approvals` `ApprovalPolicy` shape).
/// Mirrors AgentDefinition's immutable-version model — each edit appends a new
/// version; the latest non-deleted row per (orgId, policyId) is the active one.
model ApprovalPolicy {
  id        String    @id @default(uuid()) @db.Uuid
  orgId     String?   @map("org_id") @db.Uuid
  policyId  String    @map("policy_id") @db.Text
  version   Int
  document  Json
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@unique([orgId, policyId, version])
  @@index([orgId, policyId, deletedAt])
  @@map("approval_policies")
}

/// One metered LLM call (HELIX-57): token usage + estimated cost + attribution.
/// Written by the gateway's usage meter; rolled up by later cost-accounting work.
model TokenUsage {
  id                       String   @id @default(uuid()) @db.Uuid
  orgId                    String?  @map("org_id") @db.Text
  runId                    String?  @map("run_id") @db.Text
  agentRole                String?  @map("agent_role") @db.Text
  taskClass                String?  @map("task_class") @db.Text
  provider                 String   @db.Text
  model                    String   @db.Text
  inputTokens              Int      @map("input_tokens")
  outputTokens             Int      @map("output_tokens")
  cacheCreationInputTokens Int      @default(0) @map("cache_creation_input_tokens")
  cacheReadInputTokens     Int      @default(0) @map("cache_read_input_tokens")
  costUsd                  Decimal? @map("cost_usd") @db.Decimal(12, 6)
  latencyMs                Int?     @map("latency_ms")
  streamed                 Boolean  @default(false)
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([orgId, createdAt])
  @@index([runId])
  @@map("token_usage")
}

/// Long-term agent memory (HELIX-63): text chunks + their embedding vector for
/// similarity recall. The `embedding` column is pgvector `vector(1024)` — sized
/// for the VoyageEmbedder (voyage-3.5, 1024-dim). Written/queried via raw SQL
/// since Prisma has no native vector type. Changing the dimension requires a
/// migration that truncates the table (vectors can't be re-cast across sizes).
model MemoryEmbedding {
  id        String                 @id @default(uuid()) @db.Uuid
  orgId     String?                @map("org_id") @db.Text
  namespace String                 @db.Text
  content   String                 @db.Text
  metadata  Json?
  embedding Unsupported("vector(1024)")
  createdAt DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([orgId, namespace])
  @@map("memory_embeddings")
}
